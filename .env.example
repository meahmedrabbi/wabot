# Bot Configuration
# Copy this file to .env and fill in your values

# Bot prefix for commands (default: !)
BOT_PREFIX=!

# Your WhatsApp number without + or spaces (for owner-only commands)
# Example: 1234567890
OWNER_NUMBER=

# Bot name displayed in messages
BOT_NAME=WhatsApp Bot

# Enable message logging (true/false)
LOG_MESSAGES=false

# Auto-read incoming messages (true/false)
AUTO_READ=false
